{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "default": "Host=localhost;Port=5433;Database=coolapi;Username=postgres;Password=postgres"
  },
  "Seed": {
    "AdminEmail": "admin@example.com",
    "AdminPassword": "Admin123!"
  },
  "Jwt": {
    "Key": "dev-only-key-change-me-0123456789-abcdefghij"
  }
}
